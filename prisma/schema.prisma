// Modelo de dados do sistema de gestão do escritório.
// Todos os módulos da especificação já têm tabela; as telas chegam por etapas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  SOCIO
  ADVOGADO
  ESTAGIARIO
  SECRETARIA
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum AreaDireito {
  TRABALHISTA
  CIVEL
  FAMILIA_SUCESSOES
  SOCIETARIO
  IMOBILIARIO
  TRIBUTARIO
  PREVIDENCIARIO
  CRIMINAL
  OUTRA
}

enum StatusProcesso {
  ATIVO
  SUSPENSO
  ARQUIVADO
  ENCERRADO
}

enum TipoCompromisso {
  PRAZO
  AUDIENCIA
  REUNIAO
  TAREFA
}

enum StatusCompromisso {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

enum ContagemPrazo {
  DIAS_UTEIS
  DIAS_CORRIDOS
}

enum OrigemPublicacao {
  AASP
  DJEN
  DATAJUD
  MANUAL
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  ABERTO
  PAGO
  CANCELADO
}

enum TipoHonorario {
  FIXO
  EXITO
  MENSAL
  MISTO
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       Perfil
  oab          String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  processos     Processo[]     @relation("Responsavel")
  compromissos  Compromisso[]  @relation("ResponsavelCompromisso")
  publicacoes   Publicacao[]   @relation("ResponsavelPublicacao")
  atendimentos  Atendimento[]
  auditoria     RegistroAuditoria[]
}

model Cliente {
  id           String     @id @default(cuid())
  tipo         TipoPessoa
  nome         String
  cpfCnpj      String?    @unique
  rg           String?
  email        String?
  telefone     String?
  endereco     String?
  observacoes  String?
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  processos    ProcessoCliente[]
  atendimentos Atendimento[]
  contratos    ContratoHonorario[]
  lancamentos  Lancamento[]
  documentos   Documento[]

  @@index([nome])
}

model Processo {
  id             String         @id @default(cuid())
  numeroCnj      String?        @unique
  titulo         String
  area           AreaDireito
  status         StatusProcesso @default(ATIVO)
  tribunal       String?
  vara           String?
  comarca        String?
  parteContraria String?
  valorCausa     Decimal?       @db.Decimal(14, 2)
  dataDistribuicao DateTime?
  consultivo     Boolean        @default(false)
  observacoes    String?
  responsavelId  String
  responsavel    Usuario        @relation("Responsavel", fields: [responsavelId], references: [id])
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  clientes     ProcessoCliente[]
  andamentos   Andamento[]
  compromissos Compromisso[]
  publicacoes  Publicacao[]
  contratos    ContratoHonorario[]
  lancamentos  Lancamento[]
  documentos   Documento[]

  @@index([responsavelId])
}

model ProcessoCliente {
  processoId String
  clienteId  String
  polo       String? // autor, réu, reclamante, reclamada, interessado
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([processoId, clienteId])
}

model Andamento {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  data       DateTime
  descricao  String
  origem     OrigemPublicacao @default(MANUAL)
  codigoExterno String? // código do movimento no DataJud, para evitar duplicidade
  criadoEm   DateTime @default(now())

  @@unique([processoId, origem, codigoExterno, data])
  @@index([processoId, data])
}

model Compromisso {
  id            String            @id @default(cuid())
  tipo          TipoCompromisso
  titulo        String
  descricao     String?
  inicio        DateTime
  fim           DateTime?
  // Prazos: guardamos a base do cálculo para o advogado conferir.
  dataPublicacao DateTime?
  diasPrazo     Int?
  contagem      ContagemPrazo?
  confirmado    Boolean           @default(false)
  status        StatusCompromisso @default(PENDENTE)
  local         String?
  processoId    String?
  processo      Processo?         @relation(fields: [processoId], references: [id], onDelete: SetNull)
  responsavelId String
  responsavel   Usuario           @relation("ResponsavelCompromisso", fields: [responsavelId], references: [id])
  publicacaoId  String?           @unique
  publicacao    Publicacao?       @relation(fields: [publicacaoId], references: [id], onDelete: SetNull)
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  @@index([responsavelId, inicio])
}

model Feriado {
  id        String   @id @default(cuid())
  data      DateTime @db.Date
  descricao String
  // null = vale para todos; senão sigla do tribunal (TJSP, TRT2...)
  tribunal  String?

  @@unique([data, tribunal])
}

model Publicacao {
  id               String           @id @default(cuid())
  origem           OrigemPublicacao
  idExterno        String?
  dataDisponibilizacao DateTime
  dataPublicacao   DateTime?
  diario           String?
  numeroProcesso   String?
  texto            String
  tratada          Boolean          @default(false)
  processoId       String?
  processo         Processo?        @relation(fields: [processoId], references: [id], onDelete: SetNull)
  responsavelId    String?
  responsavel      Usuario?         @relation("ResponsavelPublicacao", fields: [responsavelId], references: [id])
  compromisso      Compromisso?
  criadoEm         DateTime         @default(now())

  @@unique([origem, idExterno])
  @@index([tratada, dataDisponibilizacao])
}

model Atendimento {
  id          String   @id @default(cuid())
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nomeContato String?
  data        DateTime
  assunto     String
  relato      String?
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  criadoEm    DateTime @default(now())
}

model ContratoHonorario {
  id          String        @id @default(cuid())
  clienteId   String
  cliente     Cliente       @relation(fields: [clienteId], references: [id])
  processoId  String?
  processo    Processo?     @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tipo        TipoHonorario
  valorFixo   Decimal?      @db.Decimal(14, 2)
  percentualExito Decimal?  @db.Decimal(5, 2)
  descricao   String?
  inicio      DateTime
  criadoEm    DateTime      @default(now())

  lancamentos Lancamento[]
}

model Lancamento {
  id          String           @id @default(cuid())
  tipo        TipoLancamento
  descricao   String
  valor       Decimal          @db.Decimal(14, 2)
  vencimento  DateTime
  pagamento   DateTime?
  status      StatusLancamento @default(ABERTO)
  categoria   String?
  reembolsavel Boolean         @default(false)
  clienteId   String?
  cliente     Cliente?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId  String?
  processo    Processo?        @relation(fields: [processoId], references: [id], onDelete: SetNull)
  contratoId  String?
  contrato    ContratoHonorario? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  criadoEm    DateTime         @default(now())

  @@index([status, vencimento])
}

model Documento {
  id         String    @id @default(cuid())
  nome       String
  caminho    String
  mimeType   String
  tamanho    Int
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  criadoEm   DateTime  @default(now())
}

model RegistroAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao      String   // criar, editar, excluir, login
  entidade  String
  entidadeId String?
  detalhes  Json?
  criadoEm  DateTime @default(now())

  @@index([entidade, entidadeId])
}
